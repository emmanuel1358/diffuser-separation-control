.venv/
__pycache__/
*.py[cod]
.DS_Store
.ruff_cache/
.pytest_cache/

# Problem calibration evidence is local scratch state. Trusted CI regenerates
# and promotes the authoritative lock/evidence bundle for Taiga.
problems/**/calibration.lock.json

# Ignore local build byproducts. Existing tracked proofs remain reviewable, but
# new continuous tasks do not need to commit generated calibration evidence.
problems/**/.alignerr/*
!problems/**/.alignerr/
!problems/**/.alignerr/ground_truth/
!problems/**/.alignerr/ground_truth/**
examples/**/.alignerr/
!examples/mle-tabular-classification/.alignerr/
examples/mle-tabular-classification/.alignerr/*
!examples/mle-tabular-classification/.alignerr/build_proof.json
!examples/mle-tabular-classification/.alignerr/calibration.evidence.json
!examples/mujoco-pendulum/.alignerr/
examples/mujoco-pendulum/.alignerr/*
!examples/mujoco-pendulum/.alignerr/build_proof.json
!examples/mujoco-pendulum/.alignerr/ground_truth/
!examples/mujoco-pendulum/.alignerr/ground_truth/**
!examples/openfoam-hydrofoil-flap/.alignerr/
examples/openfoam-hydrofoil-flap/.alignerr/*
!examples/openfoam-hydrofoil-flap/.alignerr/build_proof.json
!examples/openfoam-hydrofoil-flap/.alignerr/ground_truth/
!examples/openfoam-hydrofoil-flap/.alignerr/ground_truth/**
!examples/opensees-base-isolation/.alignerr/
examples/opensees-base-isolation/.alignerr/*
!examples/opensees-base-isolation/.alignerr/build_proof.json
!examples/opensees-base-isolation/.alignerr/ground_truth/
!examples/opensees-base-isolation/.alignerr/ground_truth/**
/.alignerr/
.env.local
.taiga_submit.json
.harness-runs/
problems/opensees-base-isolation.zip
examples/opensees-base-isolation.zip
.venv/
__pycache__/

# Base image package lists memoized by the dependency-channel image diff.
.alignerr-cache/
