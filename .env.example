# Copy this file to `.env.local` only if you want optional provider-key LLM runs.
# `.env.local` is gitignored and loaded automatically by `lbx-rl-harness`.
# Ground-truth verification and local `--runtime claude-code` runs do not require
# provider keys. If you have a Claude Code subscription, install the `claude` CLI
# and run `claude /login`; the harness uses that local OAuth session.
# If you do not have Claude Code subscription/login access, use
# `--runtime deepagents` with provider keys from this file.
# Trusted CI on your fork PR uses org secrets with `--runtime deepagents`.

# Optional global default model for `--runtime deepagents`. If unset, the harness
# uses task.toml [runner].api_model_name, usually `claude-fable-5`.
# Prefix ambiguous model names with `anthropic:`, `openai:`, or `google:`.
LBX_RL_HARNESS_MODEL=claude-fable-5

# Optional Claude Code model override for `--runtime claude-code`.
# Requires the local `claude` CLI to be installed and logged in.
# LBX_RL_CLAUDE_CODE_MODEL=claude-fable-5

# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-fable-5
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=openai:gpt-5.1

# Auto QA uses separate model settings so normal harness/rubric runs are unchanged.
# For local Anthropic Auto QA, uncomment the next line.
# LBX_RL_AUTOQA_MODEL=claude-opus-4-7
# LBX_RL_AUTOQA_REASONING_EFFORT=xhigh

# Google Gemini
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=google:gemini-3-pro
